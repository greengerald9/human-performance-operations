<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>HPO — Sprint Profile Tool</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@300;400;500&family=JetBrains+Mono:wght@300;400;500&display=swap');
:root{
  --bg:#0f1117;--surface:#161b26;--card:#1c2233;
  --border:#252d3d;--border-light:#2e3a50;
  --mist:#4a5568;--ash:#718096;--silver:#a0aec0;
  --light:#cbd5e0;--white:#f7fafc;
  --gold:#d4a843;--gold-hi:#f0c060;--gold-lo:#7a5c1e;
  --red:#e53e3e;--red-soft:rgba(229,62,62,0.08);
  --green:#38a169;--green-soft:rgba(56,161,105,0.08);
  --amber:#dd6b20;--amber-soft:rgba(221,107,32,0.08);
  --blue:#3182ce;--blue-soft:rgba(49,130,206,0.08);
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{background:var(--bg);color:var(--light);font-family:'Inter',sans-serif;font-weight:300;font-size:15px;line-height:1.7;-webkit-font-smoothing:antialiased;min-height:100vh}

/* HEADER */
.tool-header{background:var(--surface);border-bottom:1px solid var(--border);padding:0 24px;height:56px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:100}
.tool-logo{font-family:'Bebas Neue',sans-serif;font-size:1.1rem;letter-spacing:.14em;color:var(--white);display:flex;align-items:center;gap:7px}
.tool-logo-dot{width:6px;height:6px;background:var(--gold);border-radius:50%}
.tool-name{font-family:'JetBrains Mono',monospace;font-size:.58rem;letter-spacing:.18em;text-transform:uppercase;color:var(--ash)}
.tool-private{font-family:'JetBrains Mono',monospace;font-size:.5rem;letter-spacing:.14em;text-transform:uppercase;color:var(--mist);background:var(--card);border:1px solid var(--border);padding:4px 10px}

/* TABS */
.tabs{display:flex;gap:1px;background:var(--border);border-bottom:1px solid var(--border)}
.tab-btn{flex:1;padding:14px 16px;font-family:'JetBrains Mono',monospace;font-size:.6rem;letter-spacing:.14em;text-transform:uppercase;background:var(--surface);color:var(--mist);border:none;cursor:pointer;transition:all .2s;text-align:center}
.tab-btn.on{background:var(--card);color:var(--gold);border-bottom:2px solid var(--gold)}
.tab-btn:hover:not(.on){background:var(--card);color:var(--light)}
.tab-panel{display:none;padding:24px}
.tab-panel.on{display:block}

/* ATHLETE CARD */
.athlete-section{background:var(--surface);border:1px solid var(--border);padding:20px;margin-bottom:20px}
.section-label{font-family:'JetBrains Mono',monospace;font-size:.56rem;letter-spacing:.18em;text-transform:uppercase;color:var(--gold);display:flex;align-items:center;gap:8px;margin-bottom:14px}
.section-label:before{content:'';width:14px;height:1px;background:var(--gold)}
.input-row{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px}
.input-group{display:flex;flex-direction:column;gap:6px}
.input-group label{font-family:'JetBrains Mono',monospace;font-size:.52rem;letter-spacing:.12em;text-transform:uppercase;color:var(--ash)}
.input-group input,
.input-group select{background:var(--card);border:1px solid var(--border);color:var(--white);padding:10px 14px;font-family:'JetBrains Mono',monospace;font-size:.75rem;letter-spacing:.06em;outline:none;transition:border-color .2s;-webkit-appearance:none;width:100%}
.input-group input:focus,
.input-group select:focus{border-color:var(--gold)}
.input-group select option{background:var(--card)}

/* PHASE INPUTS */
.phase-card{background:var(--card);border:1px solid var(--border);padding:18px;margin-bottom:12px;position:relative}
.phase-title{font-family:'Bebas Neue',sans-serif;font-size:1.1rem;letter-spacing:.06em;color:var(--white);margin-bottom:4px}
.phase-sub{font-family:'JetBrains Mono',monospace;font-size:.5rem;letter-spacing:.12em;text-transform:uppercase;color:var(--mist);margin-bottom:14px}
.phase-inputs{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.rep-input{display:flex;flex-direction:column;gap:5px}
.rep-input label{font-family:'JetBrains Mono',monospace;font-size:.48rem;letter-spacing:.1em;text-transform:uppercase;color:var(--mist)}
.rep-input input{background:var(--bg);border:1px solid var(--border);color:var(--white);padding:9px 12px;font-family:'JetBrains Mono',monospace;font-size:.82rem;letter-spacing:.06em;outline:none;transition:border-color .2s;width:100%;text-align:center}
.rep-input input:focus{border-color:var(--gold)}
.phase-badge{position:absolute;top:14px;right:14px;font-family:'JetBrains Mono',monospace;font-size:.48rem;letter-spacing:.12em;text-transform:uppercase;padding:4px 10px}
.phase-badge.p1{background:var(--green-soft);color:var(--green);border:1px solid rgba(56,161,105,.2)}
.phase-badge.p2{background:var(--blue-soft);color:var(--blue);border:1px solid rgba(49,130,206,.2)}
.phase-badge.p3{background:rgba(212,168,67,.08);color:var(--gold);border:1px solid rgba(212,168,67,.2)}

/* GENERATE BTN */
.generate-btn{width:100%;padding:16px;font-family:'JetBrains Mono',monospace;font-size:.7rem;letter-spacing:.18em;text-transform:uppercase;background:var(--gold);color:var(--bg);border:none;cursor:pointer;font-weight:500;transition:all .25s;margin-top:8px}
.generate-btn:hover{background:var(--gold-hi)}
.generate-btn:disabled{background:var(--mist);cursor:not-allowed}

/* RESULT */
.result-section{display:none;margin-top:20px}
.result-section.show{display:block}

/* PROFILE HEADER */
.profile-hdr{background:var(--surface);border:1px solid var(--border);border-left:3px solid var(--gold);padding:20px;margin-bottom:12px}
.profile-type-label{font-family:'JetBrains Mono',monospace;font-size:.52rem;letter-spacing:.18em;text-transform:uppercase;color:var(--mist);margin-bottom:6px}
.profile-type-name{font-family:'Bebas Neue',sans-serif;font-size:2rem;letter-spacing:.04em;line-height:1;margin-bottom:6px}
.profile-risk{font-family:'JetBrains Mono',monospace;font-size:.54rem;letter-spacing:.14em;text-transform:uppercase}

/* PHASE SCORES */
.phase-scores{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--border);margin-bottom:12px}
.ps-item{background:var(--surface);padding:16px 12px;text-align:center}
.ps-label{font-family:'JetBrains Mono',monospace;font-size:.48rem;letter-spacing:.12em;text-transform:uppercase;color:var(--mist);margin-bottom:6px}
.ps-val{font-family:'Bebas Neue',sans-serif;font-size:1.8rem;line-height:1;margin-bottom:3px}
.ps-unit{font-family:'JetBrains Mono',monospace;font-size:.5rem;color:var(--mist)}
.ps-note{font-family:'JetBrains Mono',monospace;font-size:.46rem;letter-spacing:.08em;text-transform:uppercase;margin-top:4px}

/* PHASE ARC VISUAL */
.arc-visual{background:var(--card);border:1px solid var(--border);padding:18px;margin-bottom:12px}
.arc-label{font-family:'JetBrains Mono',monospace;font-size:.52rem;letter-spacing:.14em;text-transform:uppercase;color:var(--ash);margin-bottom:12px}
.arc-bars{display:flex;flex-direction:column;gap:8px}
.arc-row{display:flex;align-items:center;gap:10px}
.arc-phase{font-family:'JetBrains Mono',monospace;font-size:.5rem;color:var(--ash);width:100px;flex-shrink:0}
.arc-track{flex:1;height:20px;background:var(--border);position:relative;overflow:hidden}
.arc-fill{height:100%;display:flex;align-items:center;justify-content:flex-end;padding-right:8px;transition:width 1.2s cubic-bezier(.16,1,.3,1);width:0}
.arc-fill.fast{background:linear-gradient(90deg,#0f3020,var(--green))}
.arc-fill.mod{background:linear-gradient(90deg,var(--gold-lo),var(--gold))}
.arc-fill.slow{background:linear-gradient(90deg,#601a10,var(--red))}
.arc-fill-val{font-family:'JetBrains Mono',monospace;font-size:.48rem;color:rgba(255,255,255,.8)}
.arc-note-col{font-family:'JetBrains Mono',monospace;font-size:.46rem;letter-spacing:.08em;text-transform:uppercase;width:90px;flex-shrink:0}

/* DROP-OFF */
.dropoff-row{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:var(--border);margin-bottom:12px}
.do-item{background:var(--surface);padding:14px}
.do-label{font-family:'JetBrains Mono',monospace;font-size:.5rem;letter-spacing:.12em;text-transform:uppercase;color:var(--mist);margin-bottom:5px}
.do-val{font-family:'Bebas Neue',sans-serif;font-size:1.6rem;line-height:1}
.do-note{font-family:'JetBrains Mono',monospace;font-size:.48rem;letter-spacing:.08em;text-transform:uppercase;margin-top:3px}

/* SIX TYPE RUBRIC */
.rubric-grid{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:var(--border);margin-bottom:12px}
.rubric-box{padding:14px 12px;text-align:center;transition:all .2s}
.rubric-box.highlight{border:1px solid var(--gold)}
.rubric-name{font-family:'Bebas Neue',sans-serif;font-size:.95rem;letter-spacing:.04em;line-height:1.1;margin-bottom:4px}
.rubric-sub{font-family:'JetBrains Mono',monospace;font-size:.44rem;letter-spacing:.1em;text-transform:uppercase}

/* EVENT DIRECTION */
.event-card{background:var(--surface);border:1px solid var(--border);border-left:2px solid var(--gold);padding:16px;margin-bottom:8px}
.event-title{font-family:'JetBrains Mono',monospace;font-size:.56rem;letter-spacing:.14em;text-transform:uppercase;color:var(--gold);margin-bottom:6px}
.event-body{font-size:.82rem;color:var(--ash);line-height:1.65}

/* GUIDE TAB */
.guide-card{background:var(--surface);border:1px solid var(--border);padding:20px;margin-bottom:16px}
.guide-title{font-family:'Bebas Neue',sans-serif;font-size:1.2rem;letter-spacing:.04em;color:var(--white);margin-bottom:8px}
.guide-sub{font-family:'JetBrains Mono',monospace;font-size:.52rem;letter-spacing:.14em;text-transform:uppercase;color:var(--gold);margin-bottom:12px}
.guide-steps{display:flex;flex-direction:column;gap:8px}
.guide-step{display:flex;gap:10px;align-items:flex-start}
.guide-num{font-family:'Bebas Neue',sans-serif;font-size:1.1rem;color:var(--gold);line-height:1;flex-shrink:0;width:20px}
.guide-text{font-size:.82rem;color:var(--ash);line-height:1.65}
.citation{margin-top:14px;border-top:1px solid var(--border);padding-top:10px;font-family:'JetBrains Mono',monospace;font-size:.44rem;letter-spacing:.08em;color:var(--border-light);line-height:1.8}

/* EXPORT */
.export-btn{width:100%;padding:14px;font-family:'JetBrains Mono',monospace;font-size:.65rem;letter-spacing:.16em;text-transform:uppercase;background:transparent;color:var(--gold);border:1px solid rgba(212,168,67,.3);cursor:pointer;transition:all .25s;margin-top:8px}
.export-btn:hover{background:rgba(212,168,67,.05)}

/* SQUAD TAB */
.squad-table{width:100%;border-collapse:collapse}
.squad-table th{background:var(--card);padding:10px 14px;font-family:'JetBrains Mono',monospace;font-size:.5rem;letter-spacing:.14em;text-transform:uppercase;color:var(--mist);text-align:left;border-bottom:1px solid var(--border)}
.squad-table td{padding:11px 14px;font-family:'JetBrains Mono',monospace;font-size:.56rem;color:var(--silver);border-bottom:1px solid var(--border);background:var(--surface)}
.squad-table tr:hover td{background:var(--card)}
.squad-empty{padding:40px;text-align:center;font-family:'JetBrains Mono',monospace;font-size:.56rem;letter-spacing:.12em;text-transform:uppercase;color:var(--mist)}

@media(max-width:600px){
  .phase-inputs{grid-template-columns:1fr 1fr 1fr}
  .input-row{grid-template-columns:1fr}
  .phase-scores{grid-template-columns:1fr 1fr 1fr}
  .rubric-grid{grid-template-columns:1fr 1fr}
  .dropoff-row{grid-template-columns:1fr 1fr}
}
</style>
</head>
<body>

<div class="tool-header">
  <div class="tool-logo"><div class="tool-logo-dot"></div>HPO</div>
  <div class="tool-name">Sprint Profile Tool · Track &amp; Field</div>
  <div class="tool-private">Practitioner Use Only</div>
</div>

<div class="tabs">
  <button class="tab-btn on" onclick="doTab('test',this)">Sprint Test</button>
  <button class="tab-btn" onclick="doTab('squad',this)">Squad Results</button>
  <button class="tab-btn" onclick="doTab('guide',this)">Coach Guide</button>
</div>

<!-- TEST TAB -->
<div class="tab-panel on" id="panel-test">

  <!-- ATHLETE INFO -->
  <div class="athlete-section">
    <div class="section-label">Athlete Details</div>
    <div class="input-row">
      <div class="input-group">
        <label>Athlete Name / ID</label>
        <input type="text" id="athleteName" placeholder="Player 7 or initials" autocomplete="off"/>
      </div>
      <div class="input-group">
        <label>Event Direction</label>
        <select id="eventDir" autocomplete="off">
          <option value="">Select event</option>
          <option value="sprints">Sprints — 60m / 100m / 200m</option>
          <option value="hurdles">Hurdles</option>
          <option value="jumps">Jumps — Long / High / Triple</option>
          <option value="multievent">Multi-Event</option>
          <option value="football">Football / Team Sport</option>
          <option value="unknown">Undecided</option>
        </select>
      </div>
    </div>
    <div class="input-row">
      <div class="input-group">
        <label>Age</label>
        <input type="number" id="athleteAge" placeholder="17" autocomplete="off"/>
      </div>
      <div class="input-group">
        <label>Test Date</label>
        <input type="date" id="testDate" autocomplete="off"/>
      </div>
    </div>
  </div>

  <!-- PHASE 1 — ACCELERATION -->
  <div class="phase-card">
    <div class="phase-badge p1">Phase 1</div>
    <div class="phase-title">Acceleration</div>
    <div class="phase-sub">10m Sprint · 3 Reps · Best Time Used · Rolling Start from Standing</div>
    <div class="phase-inputs">
      <div class="rep-input"><label>Rep 1</label><input type="number" step="0.01" min="0" placeholder="1.68" id="p1r1" autocomplete="off"/></div>
      <div class="rep-input"><label>Rep 2</label><input type="number" step="0.01" min="0" placeholder="1.71" id="p1r2" autocomplete="off"/></div>
      <div class="rep-input"><label>Rep 3</label><input type="number" step="0.01" min="0" placeholder="1.65" id="p1r3" autocomplete="off"/></div>
    </div>
  </div>

  <!-- PHASE 2 — MAXIMUM VELOCITY -->
  <div class="phase-card">
    <div class="phase-badge p2">Phase 2</div>
    <div class="phase-title">Maximum Velocity</div>
    <div class="phase-sub">30m Sprint · 3 Reps · Best Time Used · Flying 10m (20m–30m) recorded separately</div>
    <div class="phase-inputs">
      <div class="rep-input"><label>30m Rep 1</label><input type="number" step="0.01" min="0" placeholder="4.20" id="p2r1" autocomplete="off"/></div>
      <div class="rep-input"><label>30m Rep 2</label><input type="number" step="0.01" min="0" placeholder="4.18" id="p2r2" autocomplete="off"/></div>
      <div class="rep-input"><label>30m Rep 3</label><input type="number" step="0.01" min="0" placeholder="4.22" id="p2r3" autocomplete="off"/></div>
    </div>
    <div class="phase-inputs" style="margin-top:10px">
      <div class="rep-input"><label>Flying 10m Rep 1</label><input type="number" step="0.01" min="0" placeholder="1.05" id="f10r1" autocomplete="off"/></div>
      <div class="rep-input"><label>Flying 10m Rep 2</label><input type="number" step="0.01" min="0" placeholder="1.03" id="f10r2" autocomplete="off"/></div>
      <div class="rep-input"><label>Flying 10m Rep 3</label><input type="number" step="0.01" min="0" placeholder="1.07" id="f10r3" autocomplete="off"/></div>
    </div>
  </div>

  <!-- PHASE 3 — SPEED ENDURANCE -->
  <div class="phase-card">
    <div class="phase-badge p3">Phase 3</div>
    <div class="phase-title">Speed Endurance</div>
    <div class="phase-sub">60m Sprint · 2 Reps · Best Time Used · Full Recovery Between Reps</div>
    <div class="phase-inputs">
      <div class="rep-input"><label>Rep 1</label><input type="number" step="0.01" min="0" placeholder="7.85" id="p3r1" autocomplete="off"/></div>
      <div class="rep-input"><label>Rep 2</label><input type="number" step="0.01" min="0" placeholder="7.90" id="p3r2" autocomplete="off"/></div>
      <div class="rep-input"><label>Rep 3 (optional)</label><input type="number" step="0.01" min="0" placeholder="—" id="p3r3" autocomplete="off"/></div>
    </div>
  </div>

  <button class="generate-btn" onclick="generateProfile()">Generate Sprint Profile</button>

  <!-- RESULT -->
  <div class="result-section" id="resultSection">

    <div class="profile-hdr" id="profileHdr">
      <div class="profile-type-label">Sprint Profile Type</div>
      <div class="profile-type-name" id="profileTypeName"></div>
      <div class="profile-risk" id="profileRisk"></div>
    </div>

    <div class="phase-scores" id="phaseScores"></div>

    <div class="arc-visual">
      <div class="arc-label">Phase Performance Arc</div>
      <div class="arc-bars" id="arcBars"></div>
    </div>

    <div class="dropoff-row" id="dropoffRow"></div>

    <div style="margin-bottom:8px">
      <div class="section-label" style="padding:0;margin-bottom:10px">Sprint Profile — Where This Athlete Sits</div>
      <div class="rubric-grid" id="rubricGrid"></div>
    </div>

    <div id="eventCards"></div>

    <button class="export-btn" onclick="exportResult()">Export Profile → Text</button>

  </div>
</div>

<!-- SQUAD TAB -->
<div class="tab-panel" id="panel-squad">
  <div class="section-label" style="margin-bottom:16px">Squad Sprint Profiles</div>
  <div id="squadContent">
    <div class="squad-empty">No profiles recorded yet. Run tests in the Sprint Test tab.</div>
  </div>
</div>

<!-- GUIDE TAB -->
<div class="tab-panel" id="panel-guide">

  <div class="guide-card">
    <div class="guide-title">Phase 1 — Acceleration</div>
    <div class="guide-sub">10m Sprint · Standing Start</div>

    <!-- SVG DIAGRAM — 10m sprint -->
    <svg viewBox="0 0 320 200" xmlns="http://www.w3.org/2000/svg" style="width:100%;max-width:320px;display:block;margin:0 auto 16px">
      <defs>
        <marker id="arrowG" markerWidth="8" markerHeight="8" refX="4" refY="4" orient="auto">
          <path d="M0,0 L8,4 L0,8 Z" fill="#38a169"/>
        </marker>
      </defs>
      <rect x="140" y="10" width="40" height="180" fill="#161b26" rx="2"/>
      <line x1="110" y1="40" x2="230" y2="40" stroke="#d4a843" stroke-width="2" stroke-dasharray="6,3"/>
      <text x="238" y="44" fill="#d4a843" font-family="JetBrains Mono,monospace" font-size="8" letter-spacing="1">START</text>
      <text x="238" y="55" fill="#718096" font-family="JetBrains Mono,monospace" font-size="7">0m</text>
      <line x1="110" y1="170" x2="230" y2="170" stroke="#38a169" stroke-width="2" stroke-dasharray="4,3"/>
      <text x="238" y="174" fill="#38a169" font-family="JetBrains Mono,monospace" font-size="8">10m</text>
      <line x1="160" y1="55" x2="160" y2="155" stroke="#38a169" stroke-width="2.5" marker-end="url(#arrowG)"/>
      <text x="100" y="115" fill="#38a169" font-family="JetBrains Mono,monospace" font-size="7" text-anchor="middle" transform="rotate(-90,100,115)">ACCELERATE</text>
      <polygon points="160,28 152,42 168,42" fill="#d4a843"/>
      <circle cx="160" cy="40" r="7" fill="#d4a843" opacity=".2"/>
      <text x="160" y="44" fill="#d4a843" font-family="JetBrains Mono,monospace" font-size="7" text-anchor="middle">P</text>
      <text x="160" y="185" fill="#38a169" font-family="JetBrains Mono,monospace" font-size="7" text-anchor="middle">STOP</text>
    </svg>

    <div class="guide-steps">
      <div class="guide-step"><div class="guide-num">1</div><div class="guide-text">Cone at 0m start. Cone at 10m finish. Athlete in standing start position — feet staggered, slight forward lean.</div></div>
      <div class="guide-step"><div class="guide-num">2</div><div class="guide-text">Stopwatch starts on first movement. Stops when athlete crosses 10m cone.</div></div>
      <div class="guide-step"><div class="guide-num">3</div><div class="guide-text">3 reps. Full recovery between reps — minimum 90 seconds. Best time used for profile.</div></div>
      <div class="guide-step"><div class="guide-num">4</div><div class="guide-text">This measures pure first step quickness and drive phase power. The foundation of every sprint profile.</div></div>
    </div>
  </div>

  <div class="guide-card">
    <div class="guide-title">Phase 2 — Maximum Velocity</div>
    <div class="guide-sub">30m Sprint + Flying 10m (20m–30m)</div>

    <!-- SVG DIAGRAM — 30m + flying 10m -->
    <svg viewBox="0 0 320 240" xmlns="http://www.w3.org/2000/svg" style="width:100%;max-width:320px;display:block;margin:0 auto 16px">
      <defs>
        <marker id="arrowG2" markerWidth="8" markerHeight="8" refX="4" refY="4" orient="auto">
          <path d="M0,0 L8,4 L0,8 Z" fill="#38a169"/>
        </marker>
        <marker id="arrowB" markerWidth="8" markerHeight="8" refX="4" refY="4" orient="auto">
          <path d="M0,0 L8,4 L0,8 Z" fill="#3182ce"/>
        </marker>
      </defs>
      <rect x="140" y="10" width="40" height="220" fill="#161b26" rx="2"/>
      <line x1="110" y1="30" x2="230" y2="30" stroke="#d4a843" stroke-width="2" stroke-dasharray="6,3"/>
      <text x="238" y="34" fill="#d4a843" font-family="JetBrains Mono,monospace" font-size="8">START 0m</text>
      <line x1="110" y1="110" x2="230" y2="110" stroke="#3182ce" stroke-width="1.5" stroke-dasharray="4,3"/>
      <text x="238" y="114" fill="#3182ce" font-family="JetBrains Mono,monospace" font-size="8">20m</text>
      <line x1="110" y1="155" x2="230" y2="155" stroke="#3182ce" stroke-width="1.5" stroke-dasharray="4,3"/>
      <text x="238" y="159" fill="#3182ce" font-family="JetBrains Mono,monospace" font-size="8">30m</text>
      <!-- Flying 10m bracket -->
      <line x1="108" y1="112" x2="108" y2="153" stroke="#3182ce" stroke-width="1.5"/>
      <line x1="103" y1="112" x2="113" y2="112" stroke="#3182ce" stroke-width="1"/>
      <line x1="103" y1="153" x2="113" y2="153" stroke="#3182ce" stroke-width="1"/>
      <text x="90" y="136" fill="#3182ce" font-family="JetBrains Mono,monospace" font-size="6.5" text-anchor="middle" transform="rotate(-90,90,136)">FLYING 10m</text>
      <!-- Sprint arrow -->
      <line x1="160" y1="42" x2="160" y2="142" stroke="#38a169" stroke-width="2.5" marker-end="url(#arrowG2)"/>
      <polygon points="160,18 152,32 168,32" fill="#d4a843"/>
      <text x="160" y="225" fill="#38a169" font-family="JetBrains Mono,monospace" font-size="7" text-anchor="middle">DECELERATE</text>
    </svg>

    <div class="guide-steps">
      <div class="guide-step"><div class="guide-num">1</div><div class="guide-text">Cones at 0m, 20m, and 30m. Athlete sprints full effort from standing start.</div></div>
      <div class="guide-step"><div class="guide-num">2</div><div class="guide-text">Two timers — one for full 30m, one for the flying 10m window (20m to 30m).</div></div>
      <div class="guide-step"><div class="guide-num">3</div><div class="guide-text">The flying 10m isolates maximum velocity — speed reached without acceleration cost. This is the number that predicts sprint ceiling.</div></div>
      <div class="guide-step"><div class="guide-num">4</div><div class="guide-text">3 reps. 2–3 minutes full recovery between reps. Best times used.</div></div>
    </div>
  </div>

  <div class="guide-card">
    <div class="guide-title">Phase 3 — Speed Endurance</div>
    <div class="guide-sub">60m Sprint · Full Effort</div>

    <svg viewBox="0 0 320 260" xmlns="http://www.w3.org/2000/svg" style="width:100%;max-width:320px;display:block;margin:0 auto 16px">
      <defs>
        <marker id="arrowA" markerWidth="8" markerHeight="8" refX="4" refY="4" orient="auto">
          <path d="M0,0 L8,4 L0,8 Z" fill="#d4a843"/>
        </marker>
      </defs>
      <rect x="140" y="10" width="40" height="240" fill="#161b26" rx="2"/>
      <line x1="110" y1="30" x2="230" y2="30" stroke="#d4a843" stroke-width="2" stroke-dasharray="6,3"/>
      <text x="238" y="34" fill="#d4a843" font-family="JetBrains Mono,monospace" font-size="8">0m</text>
      <line x1="110" y1="100" x2="230" y2="100" stroke="#718096" stroke-width="1" stroke-dasharray="3,4"/>
      <text x="238" y="104" fill="#718096" font-family="JetBrains Mono,monospace" font-size="7">20m</text>
      <line x1="110" y1="165" x2="230" y2="165" stroke="#718096" stroke-width="1" stroke-dasharray="3,4"/>
      <text x="238" y="169" fill="#718096" font-family="JetBrains Mono,monospace" font-size="7">40m</text>
      <line x1="110" y1="230" x2="230" y2="230" stroke="#d4a843" stroke-width="2" stroke-dasharray="6,3"/>
      <text x="238" y="234" fill="#d4a843" font-family="JetBrains Mono,monospace" font-size="8">60m FINISH</text>
      <line x1="160" y1="42" x2="160" y2="215" stroke="#d4a843" stroke-width="2.5" marker-end="url(#arrowA)"/>
      <polygon points="160,18 152,32 168,32" fill="#d4a843"/>
    </svg>

    <div class="guide-steps">
      <div class="guide-step"><div class="guide-num">1</div><div class="guide-text">60m straight sprint. Standing start. Full effort through the finish line — don't decelerate before the cone.</div></div>
      <div class="guide-step"><div class="guide-num">2</div><div class="guide-text">2 reps minimum. 4–5 minutes full recovery. This tests the ability to maintain speed under fatigue.</div></div>
      <div class="guide-step"><div class="guide-num">3</div><div class="guide-text">Compare to Phase 1 and Phase 2 times. The drop-off percentage reveals the speed endurance profile — critical for 100m, 200m, and football sprint demands.</div></div>
    </div>

    <div class="citation">
      Sprint phase methodology — Haugen, T. et al. (2019). Sprint mechanical properties in athletes. International Journal of Sports Physiology and Performance.<br/>
      Phase profiling framework — HPO Individual Development System. Human Performance Operations, 2026.
    </div>
  </div>

  <!-- SIX PROFILES REFERENCE -->
  <div class="guide-card">
    <div class="guide-title">Six Sprint Profiles</div>
    <div class="guide-sub">Reference Only — Profile Generated Automatically from Test Data</div>
    <div style="display:flex;flex-direction:column;gap:8px">
      <div style="background:var(--card);padding:12px 14px;border-left:2px solid var(--green)">
        <div style="font-family:'Bebas Neue',sans-serif;font-size:.95rem;color:#38a169;margin-bottom:3px">The Complete Sprinter</div>
        <div style="font-family:'JetBrains Mono',monospace;font-size:.48rem;letter-spacing:.08em;text-transform:uppercase;color:var(--mist)">Fast across all three phases · Low drop-off · Rare profile</div>
      </div>
      <div style="background:var(--card);padding:12px 14px;border-left:2px solid var(--green)">
        <div style="font-family:'Bebas Neue',sans-serif;font-size:.95rem;color:#38a169;margin-bottom:3px">The Pure Accelerator</div>
        <div style="font-family:'JetBrains Mono',monospace;font-size:.48rem;letter-spacing:.08em;text-transform:uppercase;color:var(--mist)">Fast Phase 1 · Average Phase 2 · Fades Phase 3</div>
      </div>
      <div style="background:var(--card);padding:12px 14px;border-left:2px solid var(--blue)">
        <div style="font-family:'Bebas Neue',sans-serif;font-size:.95rem;color:#3182ce;margin-bottom:3px">The Late Bloomer</div>
        <div style="font-family:'JetBrains Mono',monospace;font-size:.48rem;letter-spacing:.08em;text-transform:uppercase;color:var(--mist)">Average Phase 1 · Fast Phase 2 · Strong Phase 3</div>
      </div>
      <div style="background:var(--card);padding:12px 14px;border-left:2px solid var(--gold)">
        <div style="font-family:'Bebas Neue',sans-serif;font-size:.95rem;color:#d4a843;margin-bottom:3px">The Strong Finisher</div>
        <div style="font-family:'JetBrains Mono',monospace;font-size:.48rem;letter-spacing:.08em;text-transform:uppercase;color:var(--mist)">Average Phase 1 · Average Phase 2 · Best Phase 3</div>
      </div>
      <div style="background:var(--card);padding:12px 14px;border-left:2px solid var(--amber)">
        <div style="font-family:'Bebas Neue',sans-serif;font-size:.95rem;color:#dd6b20;margin-bottom:3px">The Glass Sprinter</div>
        <div style="font-family:'JetBrains Mono,monospace;font-size:.48rem;letter-spacing:.08em;text-transform:uppercase;color:var(--mist)">Fast Phase 1 · Fast Phase 2 · Significant Phase 3 fade</div>
      </div>
      <div style="background:var(--card);padding:12px 14px;border-left:2px solid var(--mist)">
        <div style="font-family:'Bebas Neue',sans-serif;font-size:.95rem;color:var(--silver);margin-bottom:3px">The Grinder</div>
        <div style="font-family:'JetBrains Mono',monospace;font-size:.48rem;letter-spacing:.08em;text-transform:uppercase;color:var(--mist)">Consistent across phases · Not fast in any · High endurance base</div>
      </div>
    </div>
  </div>

</div>

<script>
let squadData = [];

function getBest(a,b,c){
  const vals = [a,b,c].map(v=>parseFloat(v)).filter(v=>!isNaN(v)&&v>0);
  return vals.length ? Math.min(...vals) : null;
}

function generateProfile(){
  const name = document.getElementById('athleteName').value || 'Athlete';
  const event = document.getElementById('eventDir').value;

  const p1 = getBest(
    document.getElementById('p1r1').value,
    document.getElementById('p1r2').value,
    document.getElementById('p1r3').value
  );
  const p2 = getBest(
    document.getElementById('p2r1').value,
    document.getElementById('p2r2').value,
    document.getElementById('p2r3').value
  );
  const f10 = getBest(
    document.getElementById('f10r1').value,
    document.getElementById('f10r2').value,
    document.getElementById('f10r3').value
  );
  const p3 = getBest(
    document.getElementById('p3r1').value,
    document.getElementById('p3r2').value,
    document.getElementById('p3r3').value
  );

  if(!p1||!p2||!p3){
    alert('Enter times for all three phases to generate a profile.');
    return;
  }

  // Normalise scores — lower time = better
  // Phase scores as percentage of benchmark
  // Benchmarks: P1 10m ~1.6–2.0s, P2 30m ~3.8–4.6s, P3 60m ~7.2–8.5s
  const p1pct = Math.max(0, Math.min(100, Math.round((2.0 - p1) / 0.4 * 100)));
  const p2pct = Math.max(0, Math.min(100, Math.round((4.6 - p2) / 0.8 * 100)));
  const p3pct = Math.max(0, Math.min(100, Math.round((8.5 - p3) / 1.3 * 100)));
  const f10pct = f10 ? Math.max(0, Math.min(100, Math.round((1.2 - f10) / 0.25 * 100))) : null;

  // Drop-off: how much slower is P3 relative to P1
  const accelPerM = p1 / 10;
  const endurPerM = p3 / 60;
  const dropoff = Math.round(((endurPerM - accelPerM) / accelPerM) * 100);

  // Profile determination
  const p1Strong = p1pct >= 60;
  const p2Strong = p2pct >= 60;
  const p3Strong = p3pct >= 60;
  const lowDropoff = dropoff < 15;

  let profile, color, risk, direction;

  const recs = {
    complete: {
      priority: 'Race Tactics · Competition Exposure · Strength Development',
      training: [
        'Maximum velocity maintenance work — 60m+ flying sprints at 95% effort',
        'Heavy lower body strength — trap bar deadlift, Bulgarian split squat, Nordic hamstring',
        'Block start refinement — first step angle and drive phase mechanics',
        'Competition block — this profile is ready, racing develops what training cannot'
      ],
      screen: 'COD screen recommended — complete sprinters often have undiscovered reactive agility ceiling',
      load: 'High intensity sprint volume manageable. Monitor hamstring load — elite acceleration profiles carry higher hamstring risk at maximum velocity.'
    },
    accelerator: {
      priority: 'Speed Endurance · Lactate Threshold · Phase 3 Development',
      training: [
        'Extended sprint reps — 60m, 80m, 100m at 85–90% to build speed endurance',
        'Lactate threshold sessions — 3–4 x 200m at controlled effort with short recovery',
        'Tempo runs — 5 x 100m at 70% effort. Builds aerobic base without killing speed',
        'Maintain Phase 1 and Phase 2 work — don\'t sacrifice existing strength chasing endurance'
      ],
      screen: 'Energy system screen recommended — aerobic base depth determines how quickly speed endurance responds to training',
      load: 'Monitor fatigue accumulation carefully. Pure accelerators often push through the fade point and accumulate hamstring and quad stress.'
    },
    late: {
      priority: 'Acceleration Mechanics · First Step Development · Drive Phase',
      training: [
        'Block start sessions — 3 x 10m block starts. Focus on first step angle not power',
        'Resisted sprints — sled or band resistance over 10–20m. Builds drive phase force',
        'Plyometric first step — single leg hops, bounding, depth jumps into sprint',
        'Hill sprints — 6–8 x 40m uphill. Forces correct drive phase mechanics naturally'
      ],
      screen: 'Movement quality screen recommended — late bloomers often have hip mobility restriction limiting drive phase angle',
      load: 'Achilles and calf load elevated during acceleration development phase. Monitor carefully. Progress sled weight slowly.'
    },
    finisher: {
      priority: 'Acceleration Development · Maximum Velocity · Top End Speed',
      training: [
        'Short sprint work — 3 x 20m maximum effort. Introduce speed the body doesn\'t currently have',
        'Block starts — 4 x 10m. First step power is the gap',
        'Plyometric power — box jumps, depth jumps, single leg bounding',
        'Flying sprints — 3 x flying 30m at maximum to develop top end speed ceiling'
      ],
      screen: 'Strength screen recommended — Strong Finishers often have underdeveloped lower body power relative to their endurance capacity',
      load: 'Low injury risk profile. Speed work is new stimulus — increase volume slowly. Muscle soreness expected in first 3–4 weeks of acceleration focus.'
    },
    glass: {
      priority: 'Speed Endurance · Lactate Threshold · Load Management',
      training: [
        'Extended tempo runs — 6 x 100m at 70% effort. Builds aerobic base without destroying speed',
        'Lactate threshold intervals — 3 x 150m at 80% effort. 3 minute recovery',
        '200m reps — 4 x 200m at 85% effort. Direct speed endurance development',
        'Maintain Phase 1 and Phase 2 — short sprint sessions 2x per week to preserve existing speed'
      ],
      screen: 'Energy system screen essential — the fade point needs quantifying. Aerobic base depth determines training response timeline',
      load: 'Highest injury risk profile. Speed present but body not conditioned to sustain it. Hamstring and quad load management critical. Never sprint to failure.'
    },
    grinder: {
      priority: 'Speed Development · Explosive Power · Event Direction Decision',
      training: [
        'Short speed sessions — 6 x 30m maximum effort. Introduce speed stimulus the body hasn\'t had',
        'Plyometric foundation — jump rope, box jumps, broad jumps. Build fast twitch recruitment',
        'Hill sprints — 8 x 20m uphill. Low impact way to develop power',
        'Consider event redirection — distance running, multi-sport, team sport. Endurance base is an asset'
      ],
      screen: 'Full physical development screen recommended — movement quality, strength, and energy system. Profile suggests multi-event or endurance pathway may produce better outcomes than sprint specialisation',
      load: 'Low injury risk. High training volume tolerance. The endurance base absorbs load well. Push training frequency and volume — this profile responds to volume not intensity.'
    }
  };

  if(p1Strong && p2Strong && p3Strong && lowDropoff){
    profile = 'The Complete Sprinter'; color = '#38a169'; risk = 'Elite Profile · Competition Ready';
    direction = recs.complete;
  } else if(p1Strong && !p3Strong && dropoff > 20){
    profile = 'The Glass Sprinter'; color = '#dd6b20'; risk = 'Speed Present · Speed Endurance Priority';
    direction = recs.glass;
  } else if(p1Strong && p2Strong && !p3Strong){
    profile = 'The Pure Accelerator'; color = '#38a169'; risk = 'Short Distance Specialist · Endurance Gap';
    direction = recs.accelerator;
  } else if(!p1Strong && p2Strong && p3Strong){
    profile = 'The Late Bloomer'; color = '#3182ce'; risk = 'Velocity Strong · Acceleration Development Needed';
    direction = recs.late;
  } else if(!p1Strong && !p2Strong && p3Strong){
    profile = 'The Strong Finisher'; color = '#d4a843'; risk = '400m / 200m Profile · Build Phase';
    direction = recs.finisher;
  } else {
    profile = 'The Grinder'; color = '#718096'; risk = 'Consistent · Speed Development Needed';
    direction = recs.grinder;
  }

  // Event specific recommendation
  const eventRecs = {
    sprints: '100m and 200m pathway — sprint phase profile directly maps to race demands. Block start development next.',
    hurdles: 'Hurdle rhythm and lead/trail leg mechanics alongside sprint phase development. Reactive agility critical.',
    jumps: 'Phase 1 acceleration and Phase 2 maximum velocity feed directly into jump approach speed. COD screen recommended alongside.',
    multievent: 'Multi-event profile — all three phases matter. Speed endurance and acceleration both priority. Decathlon/heptathlon pathway viable.',
    football: 'Football sprint demands are primarily Phase 1 (0–10m) and repeated sprint ability. Phase 3 endurance supports high intensity running volume.',
    unknown: 'Run COD screen alongside sprint profile to determine whether change of direction or linear speed is the stronger quality. Event direction follows from combined profile.'
  };

  // Render results
  const hdr = document.getElementById('profileHdr');
  hdr.style.borderLeftColor = color;
  document.getElementById('profileTypeName').style.color = color;
  document.getElementById('profileTypeName').textContent = profile;
  document.getElementById('profileRisk').style.color = color;
  document.getElementById('profileRisk').textContent = risk;

  // Phase scores
  document.getElementById('phaseScores').innerHTML = `
    <div class="ps-item">
      <div class="ps-label">Phase 1 · Acceleration</div>
      <div class="ps-val" style="color:${p1pct>=60?'#38a169':p1pct>=40?'#d4a843':'#e53e3e'}">${p1.toFixed(2)}<span class="ps-unit">s</span></div>
      <div class="ps-note" style="color:${p1pct>=60?'#38a169':p1pct>=40?'#d4a843':'#e53e3e'}">${p1pct>=60?'Strong':'Developing'}</div>
    </div>
    <div class="ps-item">
      <div class="ps-label">Phase 2 · Max Velocity</div>
      <div class="ps-val" style="color:${p2pct>=60?'#38a169':p2pct>=40?'#d4a843':'#e53e3e'}">${p2.toFixed(2)}<span class="ps-unit">s</span></div>
      <div class="ps-note" style="color:${p2pct>=60?'#38a169':p2pct>=40?'#d4a843':'#e53e3e'}">${f10?`Flying 10m ${f10.toFixed(2)}s`:'30m best'}</div>
    </div>
    <div class="ps-item">
      <div class="ps-label">Phase 3 · Speed End.</div>
      <div class="ps-val" style="color:${p3pct>=60?'#38a169':p3pct>=40?'#d4a843':'#e53e3e'}">${p3.toFixed(2)}<span class="ps-unit">s</span></div>
      <div class="ps-note" style="color:${p3pct>=60?'#38a169':p3pct>=40?'#d4a843':'#e53e3e'}">${p3pct>=60?'Strong':'Developing'}</div>
    </div>
  `;

  // Arc bars
  document.getElementById('arcBars').innerHTML = `
    <div class="arc-row">
      <div class="arc-phase">Phase 1 · 10m</div>
      <div class="arc-track"><div class="arc-fill ${p1pct>=60?'fast':p1pct>=40?'mod':'slow'}" style="width:${p1pct}%"><span class="arc-fill-val">${p1.toFixed(2)}s</span></div></div>
      <div class="arc-note-col" style="color:${p1pct>=60?'#38a169':p1pct>=40?'#d4a843':'#e53e3e'}">${p1pct>=60?'↑ Strong':p1pct>=40?'→ Average':'↓ Developing'}</div>
    </div>
    <div class="arc-row">
      <div class="arc-phase">Phase 2 · 30m</div>
      <div class="arc-track"><div class="arc-fill ${p2pct>=60?'fast':p2pct>=40?'mod':'slow'}" style="width:${p2pct}%"><span class="arc-fill-val">${p2.toFixed(2)}s</span></div></div>
      <div class="arc-note-col" style="color:${p2pct>=60?'#38a169':p2pct>=40?'#d4a843':'#e53e3e'}">${p2pct>=60?'↑ Strong':p2pct>=40?'→ Average':'↓ Developing'}</div>
    </div>
    ${f10?`<div class="arc-row">
      <div class="arc-phase">Flying 10m</div>
      <div class="arc-track"><div class="arc-fill ${f10pct>=60?'fast':f10pct>=40?'mod':'slow'}" style="width:${f10pct}%"><span class="arc-fill-val">${f10.toFixed(2)}s</span></div></div>
      <div class="arc-note-col" style="color:${f10pct>=60?'#38a169':f10pct>=40?'#d4a843':'#e53e3e'}">Max velocity</div>
    </div>`:''}
    <div class="arc-row">
      <div class="arc-phase">Phase 3 · 60m</div>
      <div class="arc-track"><div class="arc-fill ${p3pct>=60?'fast':p3pct>=40?'mod':'slow'}" style="width:${p3pct}%"><span class="arc-fill-val">${p3.toFixed(2)}s</span></div></div>
      <div class="arc-note-col" style="color:${p3pct>=60?'#38a169':p3pct>=40?'#d4a843':'#e53e3e'}">${p3pct>=60?'↑ Strong':p3pct>=40?'→ Average':'↓ Developing'}</div>
    </div>
  `;

  // Drop-off
  const dropColor = dropoff<10?'#38a169':dropoff<20?'#d4a843':'#e53e3e';
  document.getElementById('dropoffRow').innerHTML = `
    <div class="do-item">
      <div class="do-label">Phase Drop-off</div>
      <div class="do-val" style="color:${dropColor}">${dropoff}%</div>
      <div class="do-note" style="color:${dropColor}">${dropoff<10?'Low — Speed Maintained':dropoff<20?'Moderate — Monitor':' High — Endurance Gap'}</div>
    </div>
    <div class="do-item">
      <div class="do-label">Acceleration Index</div>
      <div class="do-val" style="color:#d4a843">${p1pct>=60?'Early Peak':p1pct>=40?'Mid Peak':'Late Peak'}</div>
      <div class="do-note" style="color:var(--mist)">${p1pct>=60?'Drive phase strong':p1pct>=40?'Transition dominant':'Velocity dominant'}</div>
    </div>
  `;

  // Rubric grid
  const profiles = [
    {id:'complete',name:'Complete\nSprinter',color:'#38a169',bg:'var(--green-soft)',border:'rgba(56,161,105,.3)'},
    {id:'accelerator',name:'Pure\nAccelerator',color:'#38a169',bg:'var(--green-soft)',border:'rgba(56,161,105,.3)'},
    {id:'late',name:'Late\nBloomer',color:'#3182ce',bg:'var(--blue-soft)',border:'rgba(49,130,206,.3)'},
    {id:'finisher',name:'Strong\nFinisher',color:'#d4a843',bg:'rgba(212,168,67,.08)',border:'rgba(212,168,67,.3)'},
    {id:'glass',name:'Glass\nSprinter',color:'#dd6b20',bg:'var(--amber-soft)',border:'rgba(221,107,32,.3)'},
    {id:'grinder',name:'The\nGrinder',color:'#718096',bg:'var(--card)',border:'var(--border)'},
  ];
  const profileMap = {
    'The Complete Sprinter':'complete',
    'The Pure Accelerator':'accelerator',
    'The Late Bloomer':'late',
    'The Strong Finisher':'finisher',
    'The Glass Sprinter':'glass',
    'The Grinder':'grinder'
  };
  const activeId = profileMap[profile];
  document.getElementById('rubricGrid').innerHTML = profiles.map(p=>`
    <div class="rubric-box" style="background:${p.id===activeId?p.bg:'var(--card)'};border:${p.id===activeId?`1px solid ${p.border}`:'1px solid var(--border)'}">
      <div class="rubric-name" style="color:${p.id===activeId?p.color:'var(--border-light)'};white-space:pre-line">${p.name}</div>
      ${p.id===activeId?`<div class="rubric-sub" style="color:${p.color}">✓ This Athlete</div>`:''}
    </div>
  `).join('');

  // Event direction
  const evtText = eventRecs[event] || eventRecs['unknown'];
  document.getElementById('eventCards').innerHTML = `
    <div class="event-card" style="margin-bottom:8px">
      <div class="event-title">Development Priority</div>
      <div class="event-body" style="color:${color};font-family:'JetBrains Mono',monospace;font-size:.56rem;letter-spacing:.1em;text-transform:uppercase;margin-bottom:10px">${direction.priority}</div>
      <div style="display:flex;flex-direction:column;gap:6px">
        ${direction.training.map((t,i)=>`
          <div style="display:flex;gap:8px;align-items:flex-start">
            <div style="font-family:'Bebas Neue',sans-serif;font-size:1rem;color:${color};line-height:1;flex-shrink:0;width:16px">${i+1}</div>
            <div style="font-size:.82rem;color:var(--ash);line-height:1.6">${t}</div>
          </div>
        `).join('')}
      </div>
    </div>
    <div class="event-card" style="margin-bottom:8px;border-left-color:var(--blue)">
      <div class="event-title" style="color:var(--blue)">Next Screen</div>
      <div class="event-body">${direction.screen}</div>
    </div>
    <div class="event-card" style="margin-bottom:8px;border-left-color:var(--amber)">
      <div class="event-title" style="color:var(--amber)">Load Management</div>
      <div class="event-body">${direction.load}</div>
    </div>
    ${event?`<div class="event-card">
      <div class="event-title">Event Pathway — ${document.getElementById('eventDir').options[document.getElementById('eventDir').selectedIndex].text}</div>
      <div class="event-body">${evtText}</div>
    </div>`:''}
  `;

  document.getElementById('resultSection').classList.add('show');
  document.getElementById('resultSection').scrollIntoView({behavior:'smooth',block:'start'});

  // Save to squad
  const date = document.getElementById('testDate').value || new Date().toISOString().split('T')[0];
  squadData.unshift({name, profile, p1:p1.toFixed(2), p2:p2.toFixed(2), p3:p3.toFixed(2), dropoff, date, color});
  renderSquad();
}

function renderSquad(){
  if(!squadData.length){
    document.getElementById('squadContent').innerHTML = '<div class="squad-empty">No profiles recorded yet.</div>';
    return;
  }
  document.getElementById('squadContent').innerHTML = `
    <table class="squad-table">
      <thead>
        <tr>
          <th>Athlete</th>
          <th>Profile</th>
          <th>10m</th>
          <th>30m</th>
          <th>60m</th>
          <th>Drop-off</th>
          <th>Date</th>
        </tr>
      </thead>
      <tbody>
        ${squadData.map(a=>`
          <tr>
            <td style="color:var(--white)">${a.name}</td>
            <td style="color:${a.color}">${a.profile}</td>
            <td>${a.p1}s</td>
            <td>${a.p2}s</td>
            <td>${a.p3}s</td>
            <td style="color:${a.dropoff<10?'#38a169':a.dropoff<20?'#d4a843':'#e53e3e'}">${a.dropoff}%</td>
            <td>${a.date}</td>
          </tr>
        `).join('')}
      </tbody>
    </table>
  `;
}

function exportResult(){
  const name = document.getElementById('athleteName').value || 'Athlete';
  const profile = document.getElementById('profileTypeName').textContent;
  const risk = document.getElementById('profileRisk').textContent;
  const p1 = getBest(document.getElementById('p1r1').value,document.getElementById('p1r2').value,document.getElementById('p1r3').value);
  const p2 = getBest(document.getElementById('p2r1').value,document.getElementById('p2r2').value,document.getElementById('p2r3').value);
  const p3 = getBest(document.getElementById('p3r1').value,document.getElementById('p3r2').value,document.getElementById('p3r3').value);
  const date = document.getElementById('testDate').value || new Date().toISOString().split('T')[0];

  const text = `HPO SPRINT PROFILE TOOL
Human Performance Operations
─────────────────────────────
Athlete: ${name}
Date: ${date}
─────────────────────────────
SPRINT PROFILE: ${profile}
${risk}
─────────────────────────────
Phase 1 · Acceleration (10m): ${p1?.toFixed(2)}s
Phase 2 · Maximum Velocity (30m): ${p2?.toFixed(2)}s
Phase 3 · Speed Endurance (60m): ${p3?.toFixed(2)}s
─────────────────────────────
humanperformanceoperations.com
Practitioner Use Only · HPO 2026`;

  const blob = new Blob([text],{type:'text/plain'});
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = `HPO_Sprint_Profile_${name.replace(/\s+/g,'_')}_${date}.txt`;
  a.click();
}

function doTab(id,btn){
  document.querySelectorAll('.tab-btn').forEach(t=>t.classList.remove('on'));
  document.querySelectorAll('.tab-panel').forEach(p=>p.classList.remove('on'));
  btn.classList.add('on');
  document.getElementById('panel-'+id).classList.add('on');
}
</script>
</body>
